"Refract" {
	"$model" "1"
	"$normalmap" "sprites/heatwave"

	"$refractamount" ".01"
	"$bluramount" "1"

	"$nofb" "0" // For correct refraction

	"$vertexalpha" "1" // Lets GLua fuck around with alpha
	"$vertexcolor" "1" // Reads vertex color

	"$translucent" "1"
	"$forcerefract" "1"
}
