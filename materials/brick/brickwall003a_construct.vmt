"LightmappedGeneric" {
	"$basetexture" "brick/brickwall003a"
	"$bumpmap" "brick/brickwall003a_normal"
	"$surfaceprop" "brick"
	"%keywords" "c17downtown gm_construct"

	"$detail" "detail\noise_detail_01"
	"$detailscale" "5"
	"$detailblendfactor" ".8"
	"$detailblendmode" "0"

	"$basetexturetransform" "center .5 .5 scale .35 .35 rotate 0 translate 0 0"

	"$normalmapalphaenvmapmask" "1"
	"$envmap" "env_cubemap"
	"$envmaptint" "[ .15 .15 .15 ]"
	"$envmapcontrast" "1"

	"$ssbump" "1"
	"$color" ".7"
}
